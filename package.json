{
  "name": "thinker-toolkit",
  "version": "0.2.1",
  "description": "Protocol-driven engineering skills runtime for AI-assisted development",
  "author": "Thinker Labs",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "thinker": "bin/thinker.js",
    "thinker-toolkit": "bin/thinker.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "tinypool": "^2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thinker-Toolkit/Thinker-toolkit-.git"
  },
  "bugs": {
    "url": "https://github.com/Thinker-Toolkit/Thinker-toolkit-/issues"
  },
  "homepage": "https://www.thinkerlab.tech/"
}
